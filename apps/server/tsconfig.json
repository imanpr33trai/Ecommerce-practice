{
  "extends": "@workspace/typescript-config/base.json",
  "compilerOptions": {
    "baseUrl": "./",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      
      "@generated/*": [
        "./prisma/generated/*"
      ],
      "prisma": [
        "./prisma/"
      ],
      "@db-types/*": [
        "../../packages/db-types/src/*"
      ]
    },
    "outDir": "./dist",
    "types": [
      "bun"
    ],
    "composite": true,
    "incremental": true,
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx"
  },
  "references": [
    {
      "path": "../../packages/db-types"
    }
  ]
}